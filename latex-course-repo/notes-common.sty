\msg_new:nnn { notes-common } { invalid-semantic-id }
  {
    Invalid~semantic~identifier~'#1'.~Use~lowercase~kebab-case,
    ~for~example~'open-set'.
  }

\cs_new_protected:Npn \__notesenv_slug_from_title:n #1
  {
    \tl_set:Nx \l__notesenv_id_tl
      { \tl_lower_case:n { \tl_to_str:n {#1} } }
    \regex_replace_all:nnN { [^a-z0-9]+ } { - } \l__notesenv_id_tl
    \regex_replace_once:nnN { \A -+ } { } \l__notesenv_id_tl
    \regex_replace_once:nnN { -+ \Z } { } \l__notesenv_id_tl
  }

\cs_new_protected:Npn \__notesenv_add_label:nnn #1#2#3
  {
    \IfNoValueTF{#3}
      {
        \IfNoValueTF{#2}
          { \tl_clear:N \l__notesenv_id_tl }
          { \__notesenv_slug_from_title:n {#2} }
      }
      { \tl_set:Nx \l__notesenv_id_tl { \tl_trim_spaces:n {#3} } }

    % An untitled environment without an explicit ID remains unlabeled.
    \tl_if_blank:VF \l__notesenv_id_tl
      {
        \regex_match:nVTF
          { \A [a-z0-9]+ (?: - [a-z0-9]+ )* \Z }
          \l__notesenv_id_tl
          {
            \tl_set:Nx \l__notesenv_label_tl
              { #1 : \l__notesenv_id_tl }
            \tl_set:Nx \l__notesenv_target_tl
              { notes.#1.\l__notesenv_id_tl }
            \exp_args:NV \hypertarget \l__notesenv_target_tl { }
            \exp_args:NV \label \l__notesenv_label_tl
            \bool_if:NT \g__notesenv_show_ids_bool
              {
                \group_begin:
                  \normalfont\scriptsize\color{gray}
                  \texttt{[\tl_use:N \l__notesenv_label_tl]}
                \group_end:
                \nobreak\space
              }
          }
          {
            \msg_error:nnx
              { notes-common } { invalid-semantic-id } { \l__notesenv_id_tl }
          }
      }
  }

\RenewDocumentEnvironment{definition}{o g}
  {
    \IfNoValueTF{#1}
      { \__notesenv_definition_begin: }
      { \__notesenv_definition_begin: [#1] }
    \__notesenv_add_label:nnn {def} {#1} {#2}
  }
  { \__notesenv_definition_end: }

