\tl_new:N \l__notesxref_text_tl
\tl_new:N \l__notesxref_url_tl

\msg_new:nnn { notes-common } { invalid-document-scope }
  { Invalid~document~scope~'#1'. }
\msg_new:nnn { notes-common } { invalid-reference }
  { Invalid~reference~'#1'. }
\msg_new:nnn { notes-common } { ambiguous-short-reference }
  {
    Short~reference~'#1'~is~ambiguous~because~more~than~one~document~was~used.
    ~Qualify~it~with~a~document~name.
  }
\msg_new:nnn { notes-common } { unsupported-kind }
  {
    Unsupported~reference~kind~'#1'.
    ~Use~def,~thm,~prop,~lem,~cor,~rem,~ex,~exc,~or~conv.
  }

\cs_new_protected:Npn \__notesxref_use_one:n #1
  {
    \tl_set:Nx \l__notesxref_reference_tl { \tl_trim_spaces:n {#1} }
    \tl_if_blank:VF \l__notesxref_reference_tl
      {
        \seq_if_in:NVF
          \g__notesxref_used_documents_seq \l__notesxref_reference_tl
          {
            \seq_gput_right:NV
              \g__notesxref_used_documents_seq \l__notesxref_reference_tl
          }
      }
  }

\NewDocumentCommand{\xrefuse}{m}
  { \clist_map_inline:nn {#1} { \__notesxref_use_one:n {##1} } }

\cs_new_protected:Npn \__notesxref_set_document_scope:n #1
  {
    \regex_split:nnN { :: } {#1} \l__notesxref_parts_seq
    \int_case:nnF { \seq_count:N \l__notesxref_parts_seq }
      {
        {1}
          {
            \tl_set:Nx \l__notesxref_server_tl { \notesServerRoot }
            \tl_set:Nx \l__notesxref_project_tl { \notesProjectName }
            \tl_set:Nx \l__notesxref_document_tl
              { \seq_item:Nn \l__notesxref_parts_seq {1} }
          }
        {2}
          {
            \tl_set:Nx \l__notesxref_server_tl { \notesServerRoot }
            \tl_set:Nx \l__notesxref_project_tl
              { \seq_item:Nn \l__notesxref_parts_seq {1} }
            \tl_set:Nx \l__notesxref_document_tl
              { \seq_item:Nn \l__notesxref_parts_seq {2} }
          }
        {3}
          {
            \tl_set:Nx \l__notesxref_server_tl
              { \seq_item:Nn \l__notesxref_parts_seq {1} }
            \tl_set:Nx \l__notesxref_project_tl
              { \seq_item:Nn \l__notesxref_parts_seq {2} }
            \tl_set:Nx \l__notesxref_document_tl
              { \seq_item:Nn \l__notesxref_parts_seq {3} }
          }
      }
      {
        \bool_set_false:N \l__notesxref_valid_bool
        \msg_error:nnn { notes-common } { invalid-document-scope } {#1}
      }
  }

\cs_new_protected:Npn \__notesxref_set_qualified_reference:n #1
  {
    \regex_split:nnN { :: } {#1} \l__notesxref_parts_seq
    \int_case:nnF { \seq_count:N \l__notesxref_parts_seq }
      {
        {2}
          {
            \tl_set:Nx \l__notesxref_server_tl { \notesServerRoot }
            \tl_set:Nx \l__notesxref_project_tl { \notesProjectName }
            \tl_set:Nx \l__notesxref_document_tl
              { \seq_item:Nn \l__notesxref_parts_seq {1} }
            \tl_set:Nx \l__notesxref_label_tl
              { \seq_item:Nn \l__notesxref_parts_seq {2} }
          }
        {3}
          {
            \tl_set:Nx \l__notesxref_server_tl { \notesServerRoot }
            \tl_set:Nx \l__notesxref_project_tl
              { \seq_item:Nn \l__notesxref_parts_seq {1} }
            \tl_set:Nx \l__notesxref_document_tl
              { \seq_item:Nn \l__notesxref_parts_seq {2} }
            \tl_set:Nx \l__notesxref_label_tl
              { \seq_item:Nn \l__notesxref_parts_seq {3} }
          }
        {4}
          {
            \tl_set:Nx \l__notesxref_server_tl
              { \seq_item:Nn \l__notesxref_parts_seq {1} }
            \tl_set:Nx \l__notesxref_project_tl
              { \seq_item:Nn \l__notesxref_parts_seq {2} }
            \tl_set:Nx \l__notesxref_document_tl
              { \seq_item:Nn \l__notesxref_parts_seq {3} }
            \tl_set:Nx \l__notesxref_label_tl
              { \seq_item:Nn \l__notesxref_parts_seq {4} }
          }
      }
      {
        \bool_set_false:N \l__notesxref_valid_bool
        \msg_error:nnn { notes-common } { invalid-reference } {#1}
      }
  }

\cs_new_protected:Npn \__notesxref_set_short_reference:n #1
  {
    \tl_set:Nn \l__notesxref_label_tl {#1}
    \int_case:nnF { \seq_count:N \g__notesxref_used_documents_seq }
      {
        {0}
          {
            \tl_set:Nx \l__notesxref_server_tl { \notesServerRoot }
            \tl_set:Nx \l__notesxref_project_tl { \notesProjectName }
            \tl_set:Nx \l__notesxref_document_tl { \jobname }
          }
        {1}
          {
            \tl_set:Nx \l__notesxref_reference_tl
              { \seq_item:Nn \g__notesxref_used_documents_seq {1} }
            \exp_args:NV
              \__notesxref_set_document_scope:n \l__notesxref_reference_tl
          }
      }
      {
        \bool_set_false:N \l__notesxref_valid_bool
        \msg_error:nnn
          { notes-common } { ambiguous-short-reference } {#1}
      }
  }

\cs_new_protected:Npn \__notesxref_parse_label:n #1
  {
    \regex_extract_once:nnNTF
      { \A ([A-Za-z]+) : ([a-z0-9]+ (?: - [a-z0-9]+ )*) \Z }
      {#1}
      \l__notesxref_label_match_seq
      {
        \tl_set:Nx \l__notesxref_kind_tl
          { \seq_item:Nn \l__notesxref_label_match_seq {2} }
        \tl_set:Nx \l__notesxref_id_tl
          { \seq_item:Nn \l__notesxref_label_match_seq {3} }
      }
      {
        \bool_set_false:N \l__notesxref_valid_bool
        \msg_error:nnn { notes-common } { invalid-reference } {#1}
      }
  }

\cs_new_protected:Npn \__notesxref_set_kind:
  {
    \str_case:VnF \l__notesxref_kind_tl
      {
        {def}
          {
            \tl_set:Nn \l__notesxref_kind_name_tl { definition }
          }
        {thm}
          {
            \tl_set:Nn \l__notesxref_kind_name_tl { theorem }
          }
        {prop}
          {
            \tl_set:Nn \l__notesxref_kind_name_tl { proposition }
          }
        {lem}
          {
            \tl_set:Nn \l__notesxref_kind_name_tl { lemma }
          }
        {cor}
          {
            \tl_set:Nn \l__notesxref_kind_name_tl { corollary }
          }
        {rem}
          {
            \tl_set:Nn \l__notesxref_kind_name_tl { remark }
          }
        {ex}
          {
            \tl_set:Nn \l__notesxref_kind_name_tl { example }
          }
        {exc}
          {
            \tl_set:Nn \l__notesxref_kind_name_tl { exercise }
          }
        {conv}
          {
            \tl_set:Nn \l__notesxref_kind_name_tl { convention }
          }
      }
      {
        \bool_set_false:N \l__notesxref_valid_bool
        \msg_error:nnx
          { notes-common } { unsupported-kind } { \l__notesxref_kind_tl }
      }
  }

\cs_new_protected:Npn \__notesxref_make_link:n #1
  {
    \bool_set_true:N \l__notesxref_valid_bool
    \tl_set:Nx \l__notesxref_reference_tl { \tl_trim_spaces:n {#1} }

    \regex_split:nnN { :: } {#1} \l__notesxref_parts_seq
    \int_compare:nNnTF { \seq_count:N \l__notesxref_parts_seq } = {1}
      {
        \exp_args:NV
          \__notesxref_set_short_reference:n \l__notesxref_reference_tl
      }
      {
        \exp_args:NV
          \__notesxref_set_qualified_reference:n \l__notesxref_reference_tl
      }

    \bool_if:NT \l__notesxref_valid_bool
      {
        \exp_args:NV \__notesxref_parse_label:n \l__notesxref_label_tl
        \__notesxref_set_kind:
      }

    \bool_if:NTF \l__notesxref_valid_bool
      {
        \tl_set_eq:NN \l__notesxref_display_id_tl \l__notesxref_id_tl
        \tl_replace_all:Nnn
          \l__notesxref_display_id_tl { - } { \c_space_tl }
        \tl_set:Nx \l__notesxref_text_tl
          {
            \l__notesxref_kind_name_tl \c_space_tl
            \l__notesxref_display_id_tl
          }
        \tl_set:Nx \l__notesxref_url_tl
          {
            \l__notesxref_server_tl / \l__notesxref_project_tl /
            \l__notesxref_document_tl .pdf \c_hash_str
            notes.\l__notesxref_kind_tl.\l__notesxref_id_tl
          }
      }
      { \tl_set:Nn \l__notesxref_text_tl { ?? } }
  }

\cs_new_protected:Npn \__notesxref_render_one:nnn #1#2#3
  {
    \tl_set:Nx \l__notesxref_reference_tl { \tl_trim_spaces:n {#3} }
    \cs_if_exist:cTF { r@\l__notesxref_reference_tl }
      {
        \IfNoValueTF{#2}
          {
            \int_compare:nNnTF {#1} = {1}
              {
                \exp_args:NV
                  \__notesxref_cref_star:n \l__notesxref_reference_tl
              }
              { \exp_args:NV \__notesxref_cref:n \l__notesxref_reference_tl }
          }
          {
            \int_compare:nNnTF {#1} = {1}
              {#2}
              {
                \exp_args:NV
                  \__notesxref_hyperref:nn \l__notesxref_reference_tl {#2}
              }
          }
      }
      {
        \__notesxref_make_link:n {#3}
        \IfNoValueF{#2} { \tl_set:Nn \l__notesxref_text_tl {#2} }
        \int_compare:nNnTF {#1} = {1}
          { \tl_use:N \l__notesxref_text_tl }
          {
            \exp_args:NVV
              \__notesxref_href:nn \l__notesxref_url_tl \l__notesxref_text_tl
          }
      }
  }

\cs_new_protected:Npn \__notesxref_cref:n #1 { \cref{#1} }
\cs_new_protected:Npn \__notesxref_cref_star:n #1 { \cref*{#1} }
\cs_new_protected:Npn \__notesxref_hyperref:nn #1#2 { \hyperref[#1]{#2} }
\cs_new_protected:Npn \__notesxref_href:nn #1#2 { \href{#1}{#2} }

\cs_new_protected:Npn \__notesxref_render_list:nnn #1#2#3
  {
    \bool_set_true:N \l__notesxref_first_bool
    \clist_map_inline:nn {#3}
      {
        \bool_if:NTF \l__notesxref_first_bool
          { \bool_set_false:N \l__notesxref_first_bool }
          { ,\c_space_tl }
        \__notesxref_render_one:nnn {#1} {#2} {##1}
      }
  }

\NewDocumentCommand{\xref}{s o m}
  {
    \IfBooleanTF{#1}
      { \__notesxref_render_list:nnn {1} {#2} {#3} }
      { \__notesxref_render_list:nnn {0} {#2} {#3} }
  }

\ExplSyntaxOff
