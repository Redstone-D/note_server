% Keep the standard "Proof." heading when untitled. A descriptive title uses
% the compact heading "Pf. <title>." while retaining amsthm's QED handling.
\RenewDocumentEnvironment{proof}{o}
  {
    \IfNoValueTF{#1}
      { \__notesenv_proof_begin: }
      { \__notesenv_proof_begin: [Pf.\ #1] }
  }
  { \__notesenv_proof_end: }

