% Direct PDF references carry their own location and semantic ID. No JSON,
% remote AUX file, or build-time program is required.
\ExplSyntaxOn

\seq_new:N \g__notesxref_used_documents_seq
\seq_new:N \l__notesxref_parts_seq
\seq_new:N \l__notesxref_label_match_seq
\bool_new:N \l__notesxref_valid_bool
\bool_new:N \l__notesxref_first_bool
\tl_new:N \l__notesxref_reference_tl
\tl_new:N \l__notesxref_server_tl
\tl_new:N \l__notesxref_project_tl
\tl_new:N \l__notesxref_document_tl
\tl_new:N \l__notesxref_label_tl
\tl_new:N \l__notesxref_kind_tl
