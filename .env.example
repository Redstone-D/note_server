# Copy to .env and fill in real values.
# .env is gitignored; .env.example is committed as a template.

# API key that clients must send in the X-API-Key header on /deploy/*.
NOTES_DEPLOY_KEY=change-me

# Where the per-project config lives. Each project has a subdirectory here
# containing config.json (script + args) and manifest.json (public metadata).
# The server scans this directory at startup to build its project list.
NOTES_CONFIG_ROOT=./config

# Where source-repo checkouts live. Each project's checkout is expected at
# $NOTES_SOURCES_ROOT/<project-id>/, with a latex_target/ subdir holding the
# deployable tree. Relative paths resolve from the server's working directory.
NOTES_SOURCES_ROOT=./sources

# Where published content is served from. Each project's public tree lives at
# $NOTES_ROOT/<project-id>/. Relative paths resolve from the server's working
# directory.
NOTES_ROOT=./published
